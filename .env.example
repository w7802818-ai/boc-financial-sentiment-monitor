# Copy to `.env` for local runs, or enter the same key in
# Streamlit Cloud → App settings → Secrets.
#
# DO NOT commit the real value. `.env` is already in .gitignore.

# ---------------------------------------------------------------------------
# REQUIRED for the fine-tuned DistilBERT model.
# After publishing the model to the Hugging Face Hub, set this to
# "<your-username>/boc-distilbert-sentiment".
#
# If unset, the DistilBERT module reports a clear load error and only
# FinBERT remains usable. Nothing is guessed or substituted.
# ---------------------------------------------------------------------------
HF_MODEL_ID=

# ---------------------------------------------------------------------------
# Optional. Only needed if the model repository is private.
# ---------------------------------------------------------------------------
# HF_TOKEN=
